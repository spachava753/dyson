# replay durable values returned by Dyson's time stdlib module
load("time.star", "time")

constructed = time.struct_time((2000, 1, 2, 3, 4, 5, 6, 2, 0))
---
wall = time.time()
wall_ns = time.time_ns()
monotonic = time.monotonic()
monotonic_ns = time.monotonic_ns()
perf = time.perf_counter()
perf_ns = time.perf_counter_ns()
slept = time.sleep(0)
---
epoch = time.gmtime(0)
local_epoch = time.localtime(0)
parsed = time.strptime("1970-01-01 00:00:00", "%Y-%m-%d %H:%M:%S")
---
formatted = time.strftime("%Y-%m-%d %H:%M:%S", epoch)
asctime_epoch = time.asctime(epoch)
ctime_epoch = time.ctime(0)
mktime_epoch = time.mktime(epoch)
---
load("assert.star", "assert")

assert.eq(type(constructed), "struct_time")
assert.eq(tuple(constructed), (2000, 1, 2, 3, 4, 5, 6, 2, 0))
assert.eq(constructed.tm_year, 2000)
assert.eq(constructed.tm_wday, 6)

assert.eq(type(wall), "float")
assert.eq(type(wall_ns), "int")
assert.true(wall > 0.0, "wall clock seconds")
assert.true(wall_ns > 0, "wall clock nanoseconds")
assert.eq(type(monotonic), "float")
assert.eq(type(monotonic_ns), "int")
assert.eq(type(perf), "float")
assert.eq(type(perf_ns), "int")
assert.true(monotonic >= 0.0, "monotonic")
assert.true(monotonic_ns >= 0, "monotonic_ns")
assert.true(perf >= 0.0, "perf_counter")
assert.true(perf_ns >= 0, "perf_counter_ns")
assert.eq(slept, None)

assert.eq(type(epoch), "struct_time")
assert.eq(tuple(epoch), (1970, 1, 1, 0, 0, 0, 3, 1, 0))
assert.eq(epoch.tm_year, 1970)
assert.eq(epoch.tm_wday, 3)
assert.eq(epoch[7], 1)
assert.eq(tuple(local_epoch), tuple(epoch))
assert.eq(tuple(parsed), tuple(epoch))

assert.eq(formatted, "1970-01-01 00:00:00")
assert.eq(asctime_epoch, "Thu Jan  1 00:00:00 1970")
assert.eq(ctime_epoch, "Thu Jan  1 00:00:00 1970")
assert.eq(mktime_epoch, 0.0)
